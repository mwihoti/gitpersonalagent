{
  "functions": {
    "api/opportunities.js": {
      "maxDuration": 60
    },
    "api/scan.js": {
      "maxDuration": 60
    },
    "api/telegram.js": {
      "maxDuration": 60
    },
    "api/setup-webhook.js": {
      "maxDuration": 30
    },
    "api/issue-status.js": {
      "maxDuration": 30
    },
    "api/issue-analysis.js": {
      "maxDuration": 60
    },
    "api/repo-issues.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/preferences",
      "destination": "/api/opportunities?__action=preferences"
    },
    {
      "source": "/api/opportunities/:id",
      "destination": "/api/opportunities?id=:id"
    }
  ],
  "crons": [
    {
      "path": "/api/scan",
      "schedule": "0 5 * * *"
    }
  ]
}
