# GitHub
GITHUB_TOKEN=your_github_personal_access_token

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud

# Airtable
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_TABLE_NAME=Contest Opportunities
# Table that stores Telegram subscribers (durable storage for serverless/webhook)
AIRTABLE_SUBSCRIBERS_TABLE=Subscribers

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# Optional: serve a second bot from the same deployment (…_3, …_4 also work).
# Each bot keeps its own subscriber list and replies with its own token.
TELEGRAM_BOT_TOKEN_2=
# Optional: admin chat id (unlocks /scan without needing a subscription)
TELEGRAM_CHAT_ID=
# Webhook mode (serverless): shared secret Telegram echoes back on every call
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_string
# Public URL of the deployment (used by scripts/set-webhook.js)
PUBLIC_BASE_URL=https://your-app.vercel.app

# /scan offloading — lets the bot run full scans on GitHub Actions (6h budget)
# instead of inside a serverless function. Strongly recommended on Vercel.
# Token needs `contents: write` (fine-grained) or `repo` scope (classic).
GITHUB_DISPATCH_REPO=your-username/your-repo
GITHUB_DISPATCH_TOKEN=github_pat_...

# WhatsApp (CallMeBot - free, personal use)
# 1. Save +34 644 71 71 71 as a contact
# 2. Send "I allow callmebot to send me messages" to that number on WhatsApp
# 3. You'll get an API key back
WHATSAPP_PHONE=254712345678
WHATSAPP_APIKEY=your_callmebot_apikey

# Schedule (cron syntax) - default: 8am daily
SCAN_SCHEDULE=0 8 * * *

# Vercel cron protection
CRON_SECRET=replace_with_a_long_random_string

# Dashboard/API protection
DAN_AGENT_API_KEY=replace_with_a_long_random_string

# ── Model providers ───────────────────────────────────────────────────────────
# Any subset works. They are tried in MODEL_PROVIDERS order, and each provider
# walks its model list left to right before handing over to the next one.
# MODEL_PROVIDERS=gemini,groq,xai,fallback

# Google Gemini — aistudio.google.com
# GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash

# Groq (fast open models) — console.groq.com
# GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b

# xAI Grok — console.x.ai
# XAI_API_KEY=
# XAI_MODELS=grok-4.3,grok-4.5

# Any other OpenAI-compatible endpoint as a last resort (OpenRouter shown)
# FALLBACK_API_URL=https://openrouter.ai/api/v1/chat/completions
# FALLBACK_API_KEY=
# FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct,mistralai/mistral-small
