{
  "name": "danagent",
  "version": "1.0.0",
  "description": "Repository Intelligence Dashboard - scans GitHub repos for contribution opportunities and sends a daily Telegram digest",
  "main": "agent.js",
  "scripts": {
    "scan": "node agent.js --scan",
    "start": "node agent.js --schedule",
    "setup": "node scripts/setup-airtable.js",
    "bot": "node agent.js --bot",
    "set-webhook": "node scripts/set-webhook.js",
    "dedupe-airtable": "node scripts/dedupe-airtable.js",
    "check-models": "node scripts/check-models.js",
    "dev": "node dev-server.js",
    "test": "node --test --test-concurrency=1",
    "demo:seed": "node scripts/seed-demo-data.js",
    "demo:record": "node scripts/record-demo.js",
    "demo:encode": "ffmpeg -y -framerate 20 -i demo/frames/%05d.png -vf \"scale=1920:1080:flags=lanczos,format=yuv420p\" -r 30 -c:v libx264 -preset slow -crf 19 -movflags +faststart demo/bitcoin-contributor-demo.mp4"
  },
  "keywords": [
    "github",
    "open-source",
    "telegram",
    "airtable",
    "gemini",
    "ollama"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@vercel/functions": "^3.7.6",
    "airtable": "^0.12.2",
    "dotenv": "^17.4.2",
    "node-cron": "^4.2.1"
  }
}
